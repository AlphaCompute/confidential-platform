# alpha-kms.yaml's values, given to `alpha coco render` alone (the KMS has no runtime to pin it).
# Every value lands in the agent policy inside the init-data, so in this KMS build's Revision v2,
# and the init-data is served to anyone by GET /v1/node/evidence: nothing here may be secret.
#
# The KMS App: the Revision v2's app_id.
APP_ID=<alpha-kms App id>
KMS_IMAGE=ghcr.io/alphacompute/alpha-kms@sha256:<digest>
# A shape whose kata-tdx reference values (kata-qemu-tdx) are in the platform document.
KMS_VCPUS=<vCPUs>
KMS_MEMORY_MIB=<MiB>
# The nodes a sealed node walks to join, comma-separated: the StatefulSet's two by name and, while
# the prototype nodes serve (PRD-05 migration step 5), theirs (https://<app id>-8443s.<gateway>).
# Dropping the prototype nodes from this list is a new KMS build, joined from a Kata node.
KMS_NODE_ENDPOINTS=https://alpha-kms-0.alpha-kms-nodes.alpha-kms.svc:8443,https://alpha-kms-1.alpha-kms-nodes.alpha-kms.svc:8443,<prototype node URLs while they serve>
# The trust-zone Postgres, as the KMS login with no password in it: see README.md, "The database
# credential". A Kata node refuses to start if this URL holds a password (in its userinfo or as
# `password=`). ponytail: M2 — how the Kata KMS authenticates to the trust-zone Postgres.
DATABASE_URL=<postgres://alpha_kms_node@trust-zone postgres:5432/alpha?sslmode=verify-full>
# The PCCS the KMS fetches collateral from: the site PCCS (or the verifier cluster's own,
# alpha-infra docs/verifier-pool.md R-override). ponytail: Q2 — the site domain.
PCCS_URL=https://pccs.site1.alphacompute.internal:8081/sgx/certification/v4/
# Where the release-signed platform document is served.
PLATFORM_DOCUMENT_URL=<https://release host/platform.json>
