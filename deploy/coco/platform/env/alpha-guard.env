# alpha-guard.yaml's values (with cluster.env). Measured: changing any line is a new Revision.
APP_ID=<alpha-guard App id>
GUARD_IMAGE=ghcr.io/alphacompute/alpha-guard@sha256:<digest>
REPLICAS=<replicas>
VCPUS=<vCPUs>
MEMORY_MIB=<MiB>
# The front, by its origin and Revisions, and the Apps that may ask for a verdict.
INFERENCE_URL=https://alpha-inference:8443
INFERENCE_REVISIONS=sha256:<alpha-inference Revision>
CALLER_APPS=<App ids, comma-separated>
#
# Secret released to this App's Revision: inference-bearer (the front's caller-bearer).
