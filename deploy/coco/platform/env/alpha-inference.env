# alpha-inference.yaml's values (with cluster.env). Measured: changing any line is a new Revision.
APP_ID=<alpha-inference App id>
INFERENCE_IMAGE=ghcr.io/alphacompute/alpha-inference@sha256:<digest>
REPLICAS=<replicas>
VCPUS=<vCPUs>
MEMORY_MIB=<MiB>
UPSTREAM_URL=<https://upstream base/v1>
MODELS=<model ids, comma-separated>
# The PCCS the upstream gateway's quote is checked against. ponytail: Q2 — the site domain.
PCCS_URL=https://pccs.site1.alphacompute.internal:8081/sgx/certification/v4/
#
# Secrets released to this App's Revision: redpill-api-key, caller-bearer.
