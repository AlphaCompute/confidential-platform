# Per-cluster values for alpha-broker.yaml, alpha-guard.yaml and alpha-inference.yaml, given to
# `alpha coco render` beside the service's own file. Every value lands in the agent policy inside
# the init-data, so in the Revision: changing one is a new Revision of every service rendered with
# it. `alpha coco render` refuses a value that still holds a <placeholder>. Fill at bring-up.
#
# The runtime, pinned by digest.
RUNTIME_IMAGE=ghcr.io/alphacompute/alpha-runtime@sha256:<digest>
# Its share of the pod VM: the pod VM is sized from every container's limits, and the reference
# values carry RTMR0 per VM shape, so the sum must be a shape captured in the platform document.
RUNTIME_VCPUS=<vCPUs>
RUNTIME_MEMORY_MIB=<MiB>
# The KMS as this cluster reaches it, its CA's SPKI hash and its node Revisions, from
# `alpha sign --check` on the signed platform document. During the migration KMS_REVISIONS lists
# the prototype build and the Kata build, comma-separated.
KMS_ENDPOINTS=<https://kms node,https://kms node>
KMS_CA_SPKI_SHA256=sha256:<64 hex>
KMS_REVISIONS=sha256:<prototype KMS build>,sha256:<Kata KMS build>
