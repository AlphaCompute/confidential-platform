# alpha-broker.yaml's values (with cluster.env). Measured: changing any line is a new Revision.
APP_ID=<alpha-broker App id>
BROKER_IMAGE=ghcr.io/alphacompute/alpha-broker@sha256:<digest>
REPLICAS=<replicas>
VCPUS=<vCPUs>
MEMORY_MIB=<MiB>
# The tenant's OAuth clients at each provider (services/alpha-broker, "Configuration").
GOOGLE_CLIENT_ID=<client id>
DROPBOX_CLIENT_ID=<app key>
SLACK_CLIENT_ID=<client id>
FIGMA_CLIENT_ID=<client id>
HUBSPOT_CLIENT_ID=<client id>
NOTION_CLIENT_ID=<client id>
OAUTH_REDIRECT_BASE=<https://the tenant page that relays the code>
#
# Secrets released to this App's Revision (put with `alpha call put-secret`, never in Kubernetes):
#   google-client-secret, dropbox-client-secret, slack-client-secret, figma-client-secret,
#   hubspot-client-secret, connect-bearer, database-url
