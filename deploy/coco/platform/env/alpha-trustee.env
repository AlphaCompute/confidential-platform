# alpha-trustee.yaml's values, given to `alpha coco render` alone. Every value lands in the agent
# policy inside the init-data, so in this Trustee build's Revision v2: changing one is a new build
# for the platform document's trustee.revisions. Nothing here may be secret.
#
# The Trustee App: the Revision v2's app_id, registered by the platform organization.
APP_ID=<alpha-trustee App id>
FEED_IMAGE=ghcr.io/alphacompute/alpha-trustee-feed@sha256:<digest>
# Trustee v0.21.0 as released upstream (release-guide.md: staged-images/kbs-grpc-as,
# coco-as-grpc and rvps copied to these names), multi-arch index digests read from ghcr.io on
# 2026-10-12. Their linux/amd64 manifests:
#   kbs  sha256:4379293c1c83bbf03f0436da9154da7f8f265e2c32d7019ed75e43bcd5cde3d0
#   as   sha256:e73b7c1249ec3b5e0d676d6e984cab498fd1d24030df22c2df232b68ffca0b91
#   rvps sha256:3c478488eaf1b8a7b6580128ccf960ad4a5e4f000af5c3089c863275a1fea84a
# ponytail: G0 — that this KBS image was built with the Vault resource backend
# (kbs/docker/coco-as-grpc/Dockerfile, VAULT=true); without it the KBS refuses its configuration
# and never starts.
KBS_IMAGE=ghcr.io/confidential-containers/key-broker-service@sha256:deb3e42a9232cf0eedd8074ad1257c2d3fbefb2e9d30fd7bbe86b34327531cb3
AS_IMAGE=ghcr.io/confidential-containers/attestation-service@sha256:8cf60797181b9ca798daa21e96adbc5ec25ce65bbab81a9b0a01650805c53d44
RVPS_IMAGE=ghcr.io/confidential-containers/reference-value-provider-service@sha256:2ceafdf064f48167ccaa8768012fd0caebc879156ee9b0ae16c0ab17140513b5
# Each container's share of the pod VM; the sum must be a shape whose kata-tdx reference values
# (kata-qemu-tdx) are in the platform document.
FEED_VCPUS=<vCPUs>
FEED_MEMORY_MIB=<MiB>
KBS_VCPUS=<vCPUs>
KBS_MEMORY_MIB=<MiB>
AS_VCPUS=<vCPUs>
AS_MEMORY_MIB=<MiB>
RVPS_VCPUS=<vCPUs>
RVPS_MEMORY_MIB=<MiB>
# The KMS on this cluster, its CA's SPKI hash and its node Revisions, from `alpha sign --check`.
KMS_ENDPOINTS=https://alpha-kms.alpha-kms.svc:8443
KMS_CA_SPKI_SHA256=sha256:<64 hex>
KMS_REVISIONS=sha256:<Kata KMS build>
# The PCCS the Attestation Service fetches DCAP collateral from: the verifier cluster's own
# (alpha-infra docs/verifier-pool.md, R-override). ponytail: Q2 — the site domain.
PCCS_URL=https://pccs.site1.alphacompute.internal:8081/sgx/certification/v4/
