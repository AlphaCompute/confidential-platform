# alpha-guard on CoCo. It reaches its judging model only through alpha-inference, pinned by the
# KMS CA and the front's App (INFERENCE_APPS), never by the front's Revision: the front's Revision
# names this judge's (GUARD_REVISIONS), so a pin back by Revision could never be registered.
INFERENCE_URL=https://alpha-inference:8443
INFERENCE_APPS=<alpha-inference App id>
# The front asks for a verdict on every turn and completion, so its App is a caller now.
CALLER_APPS=<corpus-supervisor App id>,<alpha-inference App id>
#
# Secret released to this App's Revision:
#   inference-bearer   = alpha-inference's judge-bearer (not its caller-bearer)
