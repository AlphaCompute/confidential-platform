# alpha-guard on CoCo. No code change: it already reaches its judging model only through
# alpha-inference, pinned by the KMS CA and the front's Revisions.
INFERENCE_URL=https://alpha-inference:8443
INFERENCE_REVISIONS=sha256:<alpha-inference Revision>
# The front asks for a verdict on every turn and completion, so its App is a caller now.
CALLER_APPS=<corpus-supervisor App id>,<alpha-inference App id>
#
# Secret released to this App's Revision:
#   inference-bearer   = alpha-inference's judge-bearer (not its caller-bearer)
