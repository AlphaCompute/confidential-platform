# alpha-inference on CoCo, every model ours. Measured: changing any line is a new Revision.
MODELS=nvidia/nemotron-3.5-lightning,nvidia/llama-3.1-nemotron-safety-guard-8b-v3
MODEL_SERVERS={"nvidia/nemotron-3.5-lightning":{"url":"https://alpha-model-server-corpus:8443","revisions":["sha256:<corpus model-server Revision>"],"bearer":"model-server-bearer-corpus"},"nvidia/llama-3.1-nemotron-safety-guard-8b-v3":{"url":"https://alpha-model-server-guard:8443","revisions":["sha256:<guard model-server Revision>"],"bearer":"model-server-bearer-guard"}}
GUARD_URL=https://alpha-guard:8443
GUARD_REVISIONS=sha256:<alpha-guard Revision>
GUARD_POLICY={"model":"nvidia/llama-3.1-nemotron-safety-guard-8b-v3","categories":["Violence","Sexual","Criminal Planning/Confessions","Guns and Illegal Weapons","Controlled/Regulated Substances","Suicide and Self Harm","Sexual (minor)","Hate/Identity Hate","PII/Privacy","Harassment","Threat","Profanity","Needs Caution","Manipulation","Fraud/Deception","Malware","High Risk Gov Decision Making","Political/Misinformation/Conspiracy","Copyright/Trademark/Plagiarism","Unauthorized Advice","Illegal Activity","Immoral/Unethical"]}
JUDGE_MODELS=nvidia/llama-3.1-nemotron-safety-guard-8b-v3
# GUARD_ALLOW: not set, so a trailing assistant message (prefill) or an image, audio or other
# non-text part is refused with 400 content_not_judgeable rather than served unjudged.
# UPSTREAM_URL, PCCS_URL, UPSTREAM_POLICY: not set, because no model goes to an external provider.
# METRICS_PORT: not set until something scrapes it (alpha-infra's Prometheus scrapes only its own
# pods in alpha-system, and its metrics receiver is OBS-1). Set (9464), /metrics is served in plain
# HTTP on that port alone; see services/alpha-inference/README.md.
#
# Secrets released to this App's Revision:
#   caller-bearer         the members' bearer (corpus-supervisor's inference-bearer)
#   judge-bearer          alpha-guard's inference-bearer; different from caller-bearer
#   model-server-bearer-corpus, model-server-bearer-guard
#                         one bearer per model server, each the same value as the Secret of that
#                         name its model server declares (model-server.yaml)
