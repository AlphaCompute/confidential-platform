# Corpus's own model on B300. MODEL_ID is what alpha-inference's MODELS and MODEL_SERVERS name,
# and what corpus-supervisor's CORPUS_MODELS names. Fill the pins at G0.
MODEL_NAME=corpus
MODEL_ID=nvidia/nemotron-3.5-lightning
MODEL_REPO=nvidia/nemotron-3.5-lightning
MODEL_REPO_REVISION=<commit sha>
# What the seal Job printed (also in MANIFEST.sha256 on the sealed volume); open-weights refuses
# any other sealing.
WEIGHTS_MANIFEST_SHA256=sha256:<printed by seal-weights-job>
# Serving replicas, each on its own GPU, all the same Revision: at least 2, so one is always warm.
# ponytail: 2 until G0 sets the GPU budget per model.
REPLICAS=2
MAX_MODEL_LEN=131072
WEIGHTS_SIZE=80Gi
POD_VM_MEMORY_MIB=163840
POD_VM_VCPUS=16
# Tool calling flags for this model's chat template, if Corpus needs them (set at G0).
VLLM_EXTRA_ARGS=
