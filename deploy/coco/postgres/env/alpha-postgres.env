# alpha-postgres.yaml's values for `alpha coco render`. Every value lands in the agent policy
# inside the init-data, so in this Postgres build's Revision v2 (db_revisions): nothing secret.
# `alpha coco render` refuses a value that still holds a <placeholder>.
APP_ID=<alpha-postgres App id>
VOLUME_IMAGE=ghcr.io/alphacompute/alpha-volume@sha256:<digest>
POSTGRES_IMAGE=postgres:18@sha256:<digest>
POSTGRES_VCPUS=<vCPUs>
POSTGRES_MEMORY_MIB=<MiB>
POSTGRES_STORAGE=200Gi
# The KMS nodes the init container asks for the volume key, comma-separated, https only.
KMS_NODE_ENDPOINTS=https://alpha-kms-0.alpha-kms-nodes.alpha-kms.svc:8443,https://alpha-kms-1.alpha-kms-nodes.alpha-kms.svc:8443
PLATFORM_DOCUMENT_URL=<https://release host/platform.json>
# The platform document version current when this is rendered (QUESTION(PRD-05 Q2)).
PLATFORM_DOCUMENT_MIN_VERSION=<version>
# ponytail: Q2 — the site domain.
PCCS_URL=https://pccs.site1.alphacompute.internal:8081/sgx/certification/v4/
