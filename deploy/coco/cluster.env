# Per-cluster values for model-server.yaml and seal-weights-job.yaml, given to render-interim.py
# with models/<name>.env. Every value lands in the spec, so in the agent policy inside the
# init-data, so in the Revision. render-interim.py refuses a value that still holds a <placeholder>.
# Fill at G0.
#
# The model-server App (the seal Job is a Revision of the same App) and the inference front, the
# only App whose Instances a model server admits.
APP_ID=<alpha-model-server App id>
INFERENCE_APP_ID=<alpha-inference App id>
# Chargeback (alphacompute.io/tenant) and the GPU model alpha.json names, as the GPU policy does.
TENANT=alphacompute
GPU_MODEL=B300
# Images, each pinned by digest.
RUNTIME_IMAGE=ghcr.io/alphacompute/alpha-runtime@sha256:<digest>
WEIGHTS_IMAGE=ghcr.io/alphacompute/alpha-weights@sha256:<digest>
VLLM_IMAGE=vllm/vllm-openai@sha256:<digest>
FETCH_IMAGE=<huggingface_hub image>@sha256:<digest>
# The KMS: where to reach it, its CA's SPKI hash and its node Revisions (from the signed platform
# document), and its nodes' addresses for the NetworkPolicy.
KMS_ENDPOINTS=<https://kms-node:8443,...>
KMS_CA_SPKI_SHA256=sha256:<64 hex>
KMS_REVISIONS=sha256:<KMS node Revision>
KMS_CIDR=<KMS nodes' CIDR>
